{
  "name": "litetrans",
  "version": "1.0.0",
  "description": "截图即译 - 基于百度图片翻译 API 的轻量级翻译工具",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run electron:compile && concurrently \"vite\" \"wait-on http://localhost:5173 && NODE_ENV=development electron dist/electron/main.js\"",
    "electron:build": "npm run build && npm run electron:compile && electron-builder",
    "test:api": "npx ts-node scripts/test-api.ts",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:tsc": "tsc --noEmit"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.90.1",
    "axios": "^1.6.2",
    "form-data": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "build": {
    "appId": "com.litetrans.app",
    "productName": "LiteTrans",
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "LiteTrans 需要控制系统截图功能",
        "NSScreenCaptureUsageDescription": "LiteTrans 需要截图权限来翻译屏幕内容"
      }
    },
    "files": [
      "dist/**/*"
    ],
    "directories": {
      "output": "release"
    }
  }
}
