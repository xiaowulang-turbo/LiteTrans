{
	"name": "litetrans",
	"version": "1.0.0",
	"description": "截图即译 - 基于百度图片翻译 API 的轻量级翻译工具",
	"main": "./out/main/index.js",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"start": "electron-vite preview",
		"electron:build": "npm run build && electron-builder",
		"test:api": "npx ts-node scripts/test-api.ts",
		"init:release": "npx ts-node scripts/init-github-release.ts",
		"publish:release": "npx ts-node scripts/publish.ts",
		"upload:release": "npx ts-node scripts/upload-release.ts",
		"lint": "eslint src --ext .ts,.tsx",
		"lint:tsc": "tsc --noEmit"
	},
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.10.0",
		"@types/react": "^18.2.0",
		"@types/react-dom": "^18.2.0",
		"@vitejs/plugin-react": "^4.2.0",
		"autoprefixer": "^10.4.16",
		"electron": "^28.0.0",
		"electron-builder": "^24.9.1",
		"electron-vite": "^5.0.0",
		"postcss": "^8.4.32",
		"tailwindcss": "^3.3.6",
		"ts-node": "^10.9.2",
		"typescript": "^5.3.2",
		"vite": "^5.0.0"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.90.1",
		"axios": "^1.6.2",
		"form-data": "^4.0.0",
		"node-screenshots": "^0.2.1",
		"react": "^18.2.0",
		"react-dom": "^18.2.0"
	},
	"build": {
		"appId": "com.litetrans.app",
		"productName": "LiteTrans",
		"mac": {
			"category": "public.app-category.productivity",
			"target": "dmg",
			"icon": "build/icon.icns",
			"extendInfo": {
				"NSAppleEventsUsageDescription": "LiteTrans 需要控制系统截图功能",
				"NSScreenCaptureUsageDescription": "LiteTrans 需要截图权限来翻译屏幕内容"
			}
		},
		"files": [
			"out/**/*"
		],
		"extraResources": [
			{
				"from": "build/trayIcon.png",
				"to": "trayIcon.png"
			}
		],
		"directories": {
			"output": "release_v1"
		},
		"publish": [
			{
				"provider": "github",
				"owner": "xiaowulang-turbo",
				"repo": "LiteTrans-Releases",
				"private": false
			}
		]
	}
}
